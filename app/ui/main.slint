import { ComboBox, ScrollView, StandardTableView } from "std-widgets.slint";
import { Theme, Badge, Tone, Panel, Icons, IconButton, LockSwitch } from "theme.slint";
import { PageHeader, KeyValue, ActionButton, FilterBar, SearchField, StatusBanner } from "components.slint";
import { Labels } from "labels.slint";
import { TopBar, NavItem, StatusBar } from "shell.slint";
import { CardData, PeriodRow, UnassignedData, AltData, TimetableGrid, UnassignedCard, AlternativeRow } from "timetable.slint";
import { AboutPage } from "about.slint";
import { SetupFields, WorkspaceStart, WorkspaceSetup } from "workspace.slint";
import { HomeStats, SemesterHome, HomeTargetList } from "home.slint";
import { CatalogField, CatalogPage, CatalogRow } from "catalog.slint";
import { ImportPage, ImportRow, ImportView } from "import.slint";
import { ConstraintPage, ConstraintCell, ConstraintEditor, ConstraintGridRow, ConstraintRow, ConstraintView } from "constraints.slint";
import { WorkbenchPage, WorkChange, WorkChoice, WorkItem, WorkView } from "workbench.slint";
import { FinalizationPage, FinalRow, FinalView, ReviewQueuePage, ReviewQueueRow, ReviewQueueView } from "review_screen.slint";
import { ExportPage, ExportView, ExportCommand, ExportConstraint } from "export.slint";
import { BackupCount, BackupPane, BackupView, RestoreConfirmation } from "backup.slint";

export { CardData, PeriodRow, UnassignedData, AltData, Labels, SetupFields, HomeStats, CatalogRow, CatalogField, ImportRow, ImportView }
export { ConstraintCell, ConstraintEditor, ConstraintGridRow, ConstraintRow, ConstraintView }
export { WorkChange, WorkChoice, WorkItem, WorkView }
export { FinalRow, FinalView, ReviewQueueRow, ReviewQueueView }
export { ExportView, ExportCommand, ExportConstraint }
export { BackupCount, BackupView }

// 선택한 배치의 상세 정보와 대안. 넓은 화면에서는 고정 패널, 좁은 화면에서는 오버레이.
// 내용이 길면 패널 안에서 스크롤한다.
component DetailPanel inherits Panel {
    in property <bool> has-selection;
    in property <CardData> card;
    in property <string> day-label;
    in property <[int]> days;
    in property <[AltData]> alternatives;
    in property <bool> closable;
    in property <bool> interactive: true;
    callback lock-toggled();
    callback close();

    accessible-role: AccessibleRole.complementary;
    accessible-label: @tr("Details");

    ds := ScrollView {
        content-width: ds.visible-width;
        content-height: dl.preferred-height;
        dl := VerticalLayout {
            width: ds.visible-width;
            padding: 14px;
            spacing: 4px;
            HorizontalLayout {
                Text { text: @tr("Details"); font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                if root.closable: IconButton {
                    icon: Icons.close;
                    label: @tr("Close");
                    clicked => { root.close(); }
                }
            }
            Rectangle { height: 8px; }
            if !root.has-selection: Text {
                text: @tr("Select a card to see its details.");
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            if root.has-selection: VerticalLayout {
                spacing: 4px;
                Text { text: root.card.title; font-size: 18px; font-weight: 700; color: Theme.text; overflow: elide; }
                Text { text: root.card.detail; color: Theme.text-muted; overflow: elide; }
                Rectangle { height: 8px; }
                KeyValue { key: @tr("Placement"); value: Labels.slot(root.day-label, root.card.start, root.card.span); }
                KeyValue { key: @tr("Students / seats"); value: root.card.students + " / " + root.card.capacity; }
                HorizontalLayout {
                    height: 32px;
                    Text { text: @tr("Hard constraints"); color: Theme.text-muted; vertical-alignment: center; horizontal-stretch: 1; }
                    VerticalLayout { alignment: center; Badge { text: @tr("Passed"); tone: Tone.success; } }
                }
                HorizontalLayout {
                    height: 32px;
                    Text { text: @tr("Lock"); color: Theme.text-muted; vertical-alignment: center; horizontal-stretch: 1; accessible-role: AccessibleRole.none; }
                    VerticalLayout {
                        alignment: center;
                        LockSwitch {
                            checked: root.card.locked;
                            enabled: root.interactive;
                            label: @tr("Lock");
                            toggled => { root.lock-toggled(); }
                        }
                    }
                }
                Rectangle { height: 8px; }
                Text { text: @tr("Alternatives"); font-weight: 700; color: Theme.text; }
                for alt in root.alternatives: AlternativeRow {
                    data: alt;
                    day-label: Labels.weekday(root.days[alt.day]);
                }
            }
        }
    }
}

// 시간표 편성 워크벤치 (축소판)
component TimetablePage inherits Rectangle {
    in property <[CardData]> cards;
    in property <[int]> days;
    in property <[PeriodRow]> periods;
    in property <[UnassignedData]> unassigned;
    in property <[AltData]> alternatives;
    in property <int> locked-count;
    in property <int> unassigned-count;
    in property <int> conflict-count;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> interactive: true;
    in property <string> version-label;
    in-out property <int> selected: -1;
    callback lock-toggled(int);
    callback move-card(int, int, int) -> bool;
    pure callback can-move(int, int, int) -> bool;
    callback undo();
    callback redo();

    // 좁은 화면(125~150% 배율 등)에서는 상세 패널을 오버레이로 바꾼다.
    // 페이지 폭은 레이아웃이 정하므로 여기서 재면 순환이 생긴다. 창 폭으로 정해서 받는다.
    in property <bool> compact;
    in-out property <bool> detail-open;
    property <bool> has-selection: root.selected >= 0 && root.selected < root.cards.length;
    property <string> selected-day: root.has-selection ? Labels.weekday(root.days[root.cards[root.selected].day]) : "";

    VerticalLayout {
        padding: Theme.page-padding;
        spacing: 14px;

        PageHeader {
            title: @tr("Timetable");
            subtitle: @tr("Weekly workbench") + " · " + root.version-label;
            VerticalLayout { alignment: center; IconButton { icon: Icons.undo; label: @tr("Undo"); enabled: root.can-undo; clicked => { root.undo(); } } }
            VerticalLayout { alignment: center; IconButton { icon: Icons.redo; label: @tr("Redo"); enabled: root.can-redo; clicked => { root.redo(); } } }
            ActionButton { text: @tr("Reschedule"); enabled: root.interactive; }
            ActionButton { text: @tr("Auto schedule"); primary: true; enabled: root.interactive; }
            ActionButton { text: @tr("Validate & finalize"); enabled: root.interactive; }
        }

        FilterBar {
            ComboBox {
                width: root.compact ? 124px : 140px;
                model: [@tr("By year"), @tr("By instructor"), @tr("By room"), @tr("All")];
                accessible-label: @tr("View");
            }
            ComboBox {
                width: 110px;
                model: [@tr("Year 2")];
                accessible-label: @tr("Year");
            }
            SearchField {
                min-width: 120px;
                preferred-width: 200px;
                horizontal-stretch: 0;
                placeholder-text: @tr("Search courses");
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout { alignment: center; Badge { text: @tr("Lock") + " " + root.locked-count; icon: Icons.lock; } }
            VerticalLayout { alignment: center; Badge { text: @tr("Unassigned") + " " + root.unassigned-count; tone: Tone.warning; } }
            VerticalLayout {
                alignment: center;
                Badge { text: @tr("Hard conflicts") + " " + root.conflict-count; tone: root.conflict-count == 0 ? Tone.success : Tone.danger; }
            }
            if root.compact: ActionButton {
                text: @tr("Details");
                checkable: true;
                checked <=> root.detail-open;
            }
        }

        content := HorizontalLayout {
            spacing: 14px;
            vertical-stretch: 1;

            // 미배정 패널
            Panel {
                width: root.compact ? 196px : 220px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    HorizontalLayout {
                        Text { text: @tr("Unassigned"); font-weight: 700; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
                        Badge { text: root.unassigned-count; tone: Tone.warning; }
                    }
                    SearchField { placeholder-text: @tr("Search sections"); }
                    us := ScrollView {
                        vertical-stretch: 1;
                        content-width: us.visible-width;
                        content-height: ul.preferred-height;
                        ul := VerticalLayout {
                            width: us.visible-width;
                            spacing: 10px;
                            for u in root.unassigned: UnassignedCard { data: u; }
                        }
                    }
                }
            }

            // 주간 격자: 좁거나 낮은 창에서는 이 영역만 스크롤한다
            gs := ScrollView {
                horizontal-stretch: 1;
                content-width: grid.width;
                content-height: grid.height;
                grid := TimetableGrid {
                    width: max(grid.min-grid-width, gs.visible-width);
                    cards: root.cards;
                    days: root.days;
                    periods: root.periods;
                    selected <=> root.selected;
                    activated(i) => {
                        if (root.compact) {
                            root.detail-open = true;
                        }
                    }
                    move-card(i, d, s) => { return root.move-card(i, d, s); }
                    can-move(i, d, s) => { return root.can-move(i, d, s); }
                }
            }

            if !root.compact: DetailPanel {
                width: 300px;
                interactive: root.interactive;
                has-selection: root.has-selection;
                card: root.has-selection ? root.cards[root.selected] : root.cards[0];
                day-label: root.selected-day;
                days: root.days;
                alternatives: root.alternatives;
                lock-toggled => { root.lock-toggled(root.selected); }
            }
        }
    }

    if root.compact && root.detail-open: DetailPanel {
        x: root.width - self.width - 20px;
        y: content.y;
        width: 320px;
        height: content.height;
        drop-shadow-blur: 16px;
        drop-shadow-color: #0000002e;
        closable: true;
        has-selection: root.has-selection;
        card: root.has-selection ? root.cards[root.selected] : root.cards[0];
        interactive: root.interactive;
        day-label: root.selected-day;
        days: root.days;
        alternatives: root.alternatives;
        lock-toggled => { root.lock-toggled(root.selected); }
        close => { root.detail-open = false; }
    }
}

// 기준자료 (축소판): 큰 표(보이는 행만 생성) 확인용
component DataPage inherits VerticalLayout {
    in property <[[StandardListViewItem]]> rows;
    padding: Theme.page-padding;
    spacing: 14px;

    PageHeader {
        title: @tr("Data");
        subtitle: @tr("Sections, instructors and rooms for the term");
        ActionButton { text: @tr("Import"); }
        ActionButton { text: @tr("Add section"); primary: true; }
    }
    FilterBar {
        SearchField {
            min-width: 160px;
            preferred-width: 260px;
            horizontal-stretch: 0;
            placeholder-text: @tr("Search by course name or code");
        }
        Rectangle { horizontal-stretch: 1; }
        Text { text: @tr("Total") + " " + root.rows.length; color: Theme.text-muted; vertical-alignment: center; }
    }
    StandardTableView {
        vertical-stretch: 1;
        accessible-label: @tr("Sections");
        columns: [
            { title: @tr("Code") },
            { title: @tr("Section") },
            { title: @tr("Course") },
            { title: @tr("Instructor") },
            { title: @tr("Year") },
            { title: @tr("Students") },
            { title: @tr("Hours") },
            { title: @tr("Status") },
        ];
        rows: root.rows;
    }
}

component PlaceholderPage inherits VerticalLayout {
    in property <string> title;
    padding: Theme.page-padding;
    spacing: Theme.space-large;
    PageHeader { title: root.title; }
    StatusBanner { message: @tr("Not implemented yet"); }
    Rectangle { vertical-stretch: 1; }
}

export component AppWindow inherits Window {
    title: "Auler";
    min-width: 1024px;
    min-height: 640px;
    background: Theme.bg;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-body;

    in property <string> department;
    in property <int> year;
    in property <int> term;
    in property <[CardData]> cards;
    in property <[int]> days;
    in property <[PeriodRow]> periods;
    in property <[[StandardListViewItem]]> rows;
    in property <[UnassignedData]> unassigned;
    in property <[AltData]> alternatives;
    in property <int> locked-count;
    in property <int> unassigned-count;
    in property <int> conflict-count;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <string> app-version;
    in property <bool> live-workspace;
    in-out property <bool> workspace-start;
    in-out property <int> setup-mode: -1;
    in property <bool> workspace-open;
    in property <bool> sample-workspace;
    in-out property <string> workspace-error;
    in property <int> setup-year;
    in property <int> setup-season;
    in property <string> selected-term-label;
    in property <[string]> term-options;
    in property <int> term-index: -1;
    in property <int> draft-version;
    in property <int> finalized-version;
    in property <int> review-count;
    in property <HomeStats> home-stats;
    in property <[[StandardListViewItem]]> recent-work;
    in property <[string]> hard-conflicts;
    in property <int> catalog-tab;
    in property <int> catalog-subtype;
    in property <int> catalog-filter;
    in property <int> catalog-grade;
    in property <[string]> catalog-grades;
    in property <string> catalog-query;
    in property <[CatalogRow]> catalog-rows;
    in property <[string]> catalog-columns;
    in property <[float]> catalog-column-weights;
    in property <[string]> catalog-all-columns;
    in property <[bool]> catalog-visible-columns;
    in property <[CatalogField]> catalog-fields;
    in property <[string]> catalog-preview;
    in property <string> catalog-detail-title;
    in property <string> catalog-error;
    in property <int> catalog-editor;
    in property <int> catalog-sort-column: -1;
    in property <bool> catalog-descending;
    in property <int> catalog-checked-count;
    in property <ImportView> import-view;
    in property <ConstraintView> constraint-view;
    in property <WorkView> workbench-view;
    in property <ReviewQueueView> review-queue;
    in property <FinalView> final-view;
    in-out property <int> home-filter;
    property <string> context-version: root.live-workspace
        ? root.term-index < 0 ? "" : root.home-stats.editing ? Labels.draft(root.draft-version) : Labels.finalized(root.finalized-version)
        : Labels.draft(3);
    in-out property <int> page: 3;
    changed page => { if root.page != 5 { root.export-closed(); } }
    in-out property <int> language-index: 0;
    in-out property <int> selected: 3;
    callback language-selected(int);
    callback open-url(string);
    callback lock-toggled(int);
    callback move-card(int, int, int) -> bool;
    pure callback can-move(int, int, int) -> bool;
    callback undo();
    callback redo();
    callback open-workspace();
    callback open-example();
    callback restore-backup();
    callback begin-setup(int);
    callback submit-setup(SetupFields);
    callback term-selected(int);
    callback open-recent-task(int);
    callback catalog-option(int, int);
    callback catalog-search(string);
    callback catalog-select(int);
    callback catalog-check(int, bool);
    callback catalog-column(int, bool);
    callback catalog-sort(int);
    callback catalog-begin(int);
    callback catalog-edit-field(int, string);
    callback catalog-apply();
    callback catalog-close();
    callback catalog-export();
    callback import-command(int);
    callback import-select(int);
    callback import-check(int, bool);
    callback open-review(int);
    callback constraint-option(int, int);
    callback constraint-action(int, int);
    callback constraint-text(int, string);
    callback constraint-grid-cell(int, int, int);
    callback work-action(int, int);
    callback work-option(int, int);
    callback work-search(bool, string);
    callback work-slot(int, int);
    callback review-queue-action(int, int);
    callback finalize-action(int, int);
    in property <ExportView> export-view;
    callback export-command(ExportCommand, int);
    callback export-closed();
    callback export-viewport(float);
    in property <BackupView> backup-view;
    in-out property <bool> export-backup-active;
    callback save-backup();
    callback open-restored();
    callback keep-workspace();

    public function navigate-home-target(target: int) {
        root.home-filter = target;
        root.page = target == 9 ? 1 : target <= 2 ? target : target <= 4 || target == 7 ? 3 : target == 5 ? 4 : 5;
        if target == 2 { root.constraint-option(0, 3); }
        if target == 7 { root.finalize-action(0, 0); }
        if target == 9 { root.catalog-option(0, 3); root.catalog-option(1, 0); }
    }

    // 창 폭이 이보다 좁으면 시간표 상세 패널을 오버레이로 바꾼다 (내비 레일 56 + 페이지 1180).
    // 레이아웃이 창 크기 제약에 쓰이므로 바인딩이 아니라 폭이 바뀔 때 값을 정한다(순환 방지).
    out property <bool> compact-timetable;
    changed width => {
        root.compact-timetable = root.width < 1236px;
    }

    // 테스트용: 현재 화면 레이아웃의 최소 크기. 창 최소 크기(1024×640) 이하여야 잘리지 않는다.
    out property <length> layout-min-width: root-layout.min-width;
    out property <length> layout-min-height: root-layout.min-height;

    root-layout := VerticalLayout {
        TopBar {
            department: root.department;
            term-label: Labels.term-label(root.year, root.term);
            version: root.context-version;
            workspace-visible: !root.workspace-start && root.setup-mode < 0;
            live-workspace: root.live-workspace;
            term-options: root.term-options;
            term-index: root.term-index;
            language-index: root.language-index;
            language-selected(index) => { root.language-selected(index); }
            term-selected(index) => { root.term-selected(index); }
            change-workspace => { root.workspace-error = ""; root.workspace-start = true; }
        }

        if root.workspace-start && root.setup-mode < 0: WorkspaceStart {
            vertical-stretch: 1;
            can-return: root.workspace-open;
            error-message: root.workspace-error == "" ? root.backup-view.error : root.workspace-error;
            saved-path: root.backup-view.restored ? root.backup-view.saved : "";
            busy: root.backup-view.busy || root.backup-view.pending;
            new-workspace => { root.begin-setup(0); }
            open-workspace => { root.open-workspace(); }
            open-example => { root.open-example(); }
            restore-backup => { root.restore-backup(); }
            return-to-workspace => { root.workspace-error = ""; root.workspace-start = false; }
        }
        if root.setup-mode >= 0: WorkspaceSetup {
            vertical-stretch: 1;
            mode: root.setup-mode;
            department: root.setup-mode == 0 ? "" : root.department;
            initial-year: root.setup-year;
            initial-season: root.setup-season;
            copy-source: root.selected-term-label;
            error-message: root.workspace-error;
            cancelled => { root.workspace-error = ""; root.setup-mode = -1; }
            submitted(fields) => { root.submit-setup(fields); }
        }

        if !root.workspace-start && root.setup-mode < 0: HorizontalLayout {
            vertical-stretch: 1;

            Rectangle {
                width: root.page == 3 ? 56px : 208px;
                accessible-role: AccessibleRole.tab-list;
                accessible-label: @tr("Main menu");
                VerticalLayout {
                    padding: Theme.space-medium;
                    spacing: Theme.space-small;
                    NavItem { icon: Icons.home; label: @tr("Home"); compact: root.page == 3; active: root.page == 0; clicked => { root.page = 0; } }
                    NavItem { icon: Icons.data; label: @tr("Data"); compact: root.page == 3; active: root.page == 1 || (root.page == 8 && !root.import-view.from-review); clicked => { root.page = 1; } }
                    NavItem { icon: Icons.constraints; label: @tr("Constraints"); compact: root.page == 3; active: root.page == 2; clicked => { root.home-filter = 0; root.page = 2; } }
                    NavItem { icon: Icons.timetable; label: @tr("Timetable"); compact: root.page == 3; active: root.page == 3; clicked => { root.home-filter = 0; root.page = 3; } }
                    NavItem { icon: Icons.review; label: @tr("Review"); compact: root.page == 3; active: root.page == 4 || (root.page == 8 && root.import-view.from-review); count: root.live-workspace ? root.review-count : 3; clicked => { root.page = 4; } }
                    NavItem { icon: Icons.export; label: @tr("Export & Handover"); compact: root.page == 3; active: root.page == 5; clicked => { root.page = 5; } }
                    Rectangle { vertical-stretch: 1; }
                    NavItem { icon: Icons.settings; label: @tr("Settings"); compact: root.page == 3; active: root.page == 6; clicked => { root.page = 6; } }
                    NavItem { icon: Icons.info; label: @tr("About"); compact: root.page == 3; active: root.page == 7; clicked => { root.page = 7; } }
                }
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.border;
                }
            }

            if root.page == 3 && !root.live-workspace: TimetablePage {
                horizontal-stretch: 1;
                cards: root.cards;
                days: root.days;
                periods: root.periods;
                unassigned: root.unassigned;
                alternatives: root.alternatives;
                locked-count: root.locked-count;
                unassigned-count: root.unassigned-count;
                conflict-count: root.conflict-count;
                can-undo: root.can-undo;
                can-redo: root.can-redo;
                version-label: root.context-version;
                compact: root.compact-timetable;
                selected <=> root.selected;
                lock-toggled(i) => { root.lock-toggled(i); }
                move-card(i, d, s) => { return root.move-card(i, d, s); }
                can-move(i, d, s) => { return root.can-move(i, d, s); }
                undo => { root.undo(); }
                redo => { root.redo(); }
            }
            if root.page == 3 && root.live-workspace && root.home-filter != 4 && root.home-filter != 7: WorkbenchPage {
                horizontal-stretch: 1;
                view: root.workbench-view;
                cards: root.cards;
                days: root.days;
                periods: root.periods;
                editable: root.home-stats.editing;
                compact: root.compact-timetable;
                locked: root.locked-count;
                unassigned: root.unassigned-count;
                conflicts: root.conflict-count;
                version: root.context-version;
                can-undo: root.can-undo;
                can-redo: root.can-redo;
                selected <=> root.selected;
                action(kind, index) => { root.work-action(kind, index); }
                option(kind, value) => { root.work-option(kind, value); }
                search(pending, value) => { root.work-search(pending, value); }
                pick-slot(day, period) => { root.work-slot(day, period); }
                can-move(i, day, period) => { return root.can-move(i, day, period); }
                move-card(i, day, period) => { return root.move-card(i, day, period); }
                validate => { root.navigate-home-target(7); }
            }
            if root.page == 1 && !root.live-workspace: DataPage {
                horizontal-stretch: 1;
                rows: root.rows;
            }
            if root.page == 1 && root.live-workspace: CatalogPage {
                horizontal-stretch: 1;
                tab: root.catalog-tab;
                subtype: root.catalog-subtype;
                data-filter: root.catalog-filter;
                grade: root.catalog-grade;
                grades: root.catalog-grades;
                query: root.catalog-query;
                rows: root.catalog-rows;
                columns: root.catalog-columns;
                column-weights: root.catalog-column-weights;
                all-columns: root.catalog-all-columns;
                visible-columns: root.catalog-visible-columns;
                fields: root.catalog-fields;
                preview: root.catalog-preview;
                detail-title: root.catalog-detail-title;
                error-message: root.catalog-error;
                editor: root.catalog-editor;
                sort-column: root.catalog-sort-column;
                descending: root.catalog-descending;
                checked-count: root.catalog-checked-count;
                bulk-enabled: root.catalog-tab != 4;
                editing: root.home-stats.editing;
                has-term: root.term-index >= 0;
                import-available: root.term-index >= 0;
                compact: root.compact-timetable;
                tab-changed(tab) => { root.catalog-option(0, tab); }
                subtype-changed(subtype) => { root.catalog-option(1, subtype); }
                filter-changed(filter) => { root.catalog-option(2, filter); }
                grade-changed(grade) => { root.catalog-option(3, grade); }
                query-changed(query) => { root.catalog-search(query); }
                row-selected(index) => { root.catalog-select(index); }
                row-checked(index, checked) => { root.catalog-check(index, checked); }
                column-toggled(column, visible) => { root.catalog-column(column, visible); }
                sort-by(column) => { root.catalog-sort(column); }
                begin(mode) => { root.catalog-begin(mode); }
                field-edited(index, value) => { root.catalog-edit-field(index, value); }
                apply => { root.catalog-apply(); }
                close-detail => { root.catalog-close(); }
                import-data => { root.import-command(8); }
                export-data => { root.catalog-export(); }
            }
            if root.page == 7: AboutPage {
                horizontal-stretch: 1;
                version: root.app-version;
                open-url(url) => { root.open-url(url); }
            }
            if root.live-workspace && root.page == 0: SemesterHome {
                horizontal-stretch: 1;
                department: root.department;
                term-label: root.selected-term-label;
                version: root.context-version;
                stats: root.home-stats;
                tasks: root.recent-work;
                error-message: root.workspace-error;
                has-term: root.term-index >= 0;
                compact: root.compact-timetable;
                new-term => { root.begin-setup(1); }
                copy-term => { root.begin-setup(2); }
                navigate(target) => { root.navigate-home-target(target); }
                open-task(index) => { root.open-recent-task(index); }
            }
            if root.live-workspace && root.page == 2: ConstraintPage {
                horizontal-stretch: 1;
                view: root.constraint-view;
                compact: root.compact-timetable;
                action(kind, index) => { root.constraint-action(kind, index); }
                option(field, value) => { root.constraint-option(field, value); }
                text(field, value) => { root.constraint-text(field, value); }
                grid-cell(day, period, first) => { root.constraint-grid-cell(day, period, first); }
            }
            if root.live-workspace && root.page == 3 && root.home-filter == 4: HomeTargetList {
                horizontal-stretch: 1;
                title: @tr("Hard conflicts");
                empty-message: @tr("No hard conflicts in the current version.");
                entries: root.hard-conflicts;
            }
            if root.live-workspace && root.page == 3 && root.home-filter == 7: FinalizationPage {
                horizontal-stretch: 1;
                view: root.final-view;
                action(kind, index) => { root.finalize-action(kind, index); }
                navigate(target) => { root.navigate-home-target(target); }
            }
            if root.live-workspace && root.page == 4: ReviewQueuePage {
                horizontal-stretch: 1;
                view: root.review-queue;
                compact: root.compact-timetable;
                select(index) => { root.review-queue-action(1, index); }
                filter(index) => { root.review-queue-action(0, index); }
                open(index) => { root.open-review(index); }
                navigate(target) => { root.navigate-home-target(target); }
            }
            if root.live-workspace && root.page == 5: ExportPage {
                horizontal-stretch: 1;
                view: root.export-view;
                backup-view: root.backup-view;
                backup-active <=> root.export-backup-active;
                compact: root.compact-timetable;
                action(command, index) => { root.export-command(command, index); }
                viewport(width) => { root.export-viewport(width); }
                finalize => { root.navigate-home-target(7); }
                save-backup => { root.save-backup(); }
                restore-backup => { root.restore-backup(); }
            }
            if root.live-workspace && root.page == 8: ImportPage {
                horizontal-stretch: 1;
                view: root.import-view;
                compact: root.compact-timetable;
                command(code) => { root.import-command(code); }
                select-row(row) => { root.import-select(row); }
                check-row(row, checked) => { root.import-check(row, checked); }
            }
            if root.live-workspace && root.page == 6: VerticalLayout {
                horizontal-stretch: 1;
                padding: Theme.page-padding;
                spacing: Theme.space-medium;
                PageHeader { title: @tr("Settings"); subtitle: @tr("Workspace storage"); }
                BackupPane {
                    vertical-stretch: 1;
                    view: root.backup-view;
                    save-backup => { root.save-backup(); }
                    restore-backup => { root.restore-backup(); }
                }
            }
            if root.page != 1 && root.page != 3 && root.page != 7 && !root.live-workspace: PlaceholderPage {
                horizontal-stretch: 1;
                title: root.page == 0 ? @tr("Home") : root.page == 2 ? @tr("Constraints") : root.page == 4 ? @tr("Review") : root.page == 5 ? @tr("Export & Handover") : root.page == 8 ? @tr("Import") : @tr("Settings");
            }
        }

        StatusBar {
            left-text: root.backup-view.busy && root.workspace-start ? @tr("Checking workspace copy…") : root.workspace-start ? @tr("You can start without signing in.") : @tr("Local workspace");
            right-text: "Auler " + root.app-version + (root.sample-workspace || !root.live-workspace ? " · " + @tr("Sample department data") : "");
        }
    }

    if root.backup-view.pending: RestoreConfirmation {
        width: root.width;
        height: root.height;
        view: root.backup-view;
        open => { root.open-restored(); }
        cancel => { root.keep-workspace(); }
    }
}
