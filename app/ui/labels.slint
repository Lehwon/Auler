    out property <string> backup-new-path: @tr("That file already exists. Choose a new file name for the copy.");
    out property <string> backup-permissions: @tr("Auler could not protect the copy for this Windows account. Choose another location.");
    out property <string> backup-integrity: @tr("The copy failed its database integrity or record count check.");
    out property <string> backup-stopped: @tr("The workspace copy stopped. Try again.");
    public pure function backup-error(detail: string) -> string { return @tr("Could not create the workspace copy. {0}", detail); }
    out property <string> example-school-profile: @tr("Example school CSV profile");
    out property <string> export-open-pdf-error: @tr("Could not open the saved PDF.");
    out property <string> export-path-taken: @tr("A file already exists there. Choose another name or confirm replacement.");
    out property <string> export-regular-file: @tr("Choose a regular file.");
    out property <string> export-invalid-preview: @tr("Could not read the preview image. Generate it again.");
    out property <string> export-worker-stopped: @tr("The output stopped. Try again.");
    public pure function export-extension(extension: string) -> string { return @tr("Choose a .{0} file.", extension); }
    public pure function export-error(detail: string) -> string { return @tr("Could not prepare the output. {0}", detail); }
    out property <[string]> seasons: [@tr("First semester"), @tr("Summer session"), @tr("Second semester"), @tr("Winter session")];
    public pure function academic-term(year: int, season: int) -> string {
        return @tr("{0} · {1}", year, root.seasons[season]);
    }

    public pure function finalized(version: int) -> string {
        return @tr("Finalized v{0}", version);
    }
    public pure function last-finalized(version: string, time: string) -> string {
        return @tr("{0} · {1}", version, time);
    }
    public pure function workspace-error(detail: string) -> string {
        return @tr("The workspace operation failed. {0}", detail);
    }
