// 앱이 만드는 문구(요일, 상태, 단위, 사유). 원문은 영어이고 번역은 i18n/*/LC_MESSAGES/auler.po에 있다.
// 과목명·교원명·강의실 같은 원본 자료는 여기서 다루지 않는다(번역하지 않음).
// Rust 쪽 문구(표의 상태 열)도 이 전역에서 읽어 같은 번역을 쓴다.
export global Labels {
    pure callback backup-open-error(string, string) -> string;
    backup-open-error(path, reason) => { return @tr("Could not open the verified copy at {0}. {1}", path, reason); }
    out property <string> backup-terms: @tr("Semesters");
    out property <string> backup-courses: @tr("Courses");
    out property <string> backup-instructors: @tr("Instructors");
