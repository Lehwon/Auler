    out property <string> import_invalid_workbook: @tr("Check the workbook against the standard template.");
    out property <string> import_unreadable: @tr("The XLSX file could not be read. Check that the file opens in Excel.");
    out property <string> import_choose_xlsx: @tr("Choose an XLSX workbook.");
    out property <string> import_stale: @tr("The data used for this draft changed. Compare the draft with current data.");
    out property <string> import_check_document: @tr("Check the issues in this draft before applying changes.");
    out property <string> import_term_finalized: @tr("This term is finalized. Open a correction draft before applying changes.");
    out property <string> import_select_dependencies: @tr("Review the selected rows and include any records they depend on.");
    out property <string> import_undone: @tr("Undone");
    out property <string> import_new: @tr("New");
    out property <string> import_updated: @tr("Update");
    out property <string> import_term_setup: @tr("Term setup");
    out property <string> import_numeric_code: @tr("Check the original code and enter it as text to preserve leading zeros.");
    out property <string> import_ambiguous_room: @tr("Enter the building and room number.");
    out property <string> import_instructor: @tr("Check the instructor code and name in the original workbook.");
    out property <string> import_check_value: @tr("Check this value against the standard template.");
    out property <string> import_formula: @tr("Paste the formula result as a value.");
