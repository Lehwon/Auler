// 명세서 7.1 디자인 토큰 후보값. 대비 시험 후 확정한다.
export global Theme {
    out property <color> bg: #F7F8FA;
    out property <color> surface: #FFFFFF;
    out property <color> text: #182230;
    out property <color> text-muted: #475569;
    out property <color> text-subtle: #64748B;
    out property <color> border: #E3E7EE;
    out property <color> action: #2456A6;
    out property <color> action-soft: #E7EEF9;
    out property <color> neutral-soft: #EEF1F5;
    out property <color> success: #1E7A46;
    out property <color> success-soft: #E5F4EA;
    out property <color> warning: #9A5B00;
    out property <color> warning-soft: #FDF1DC;
    out property <color> danger: #B42318;
    out property <color> danger-soft: #FDE8E6;

    out property <length> radius: 6px;
    out property <length> font-body: 13px;
    out property <length> font-small: 12px;
    out property <length> font-title: 20px;
    out property <string> font-family: "Segoe UI";
}

export enum Tone { neutral, info, success, warning, danger }

// 상태·강도·출처 배지. 색만으로 의미를 전달하지 않도록 항상 텍스트를 함께 쓴다.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <Tone> tone: Tone.neutral;

    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 4px;
    background: tone == Tone.success ? Theme.success-soft
        : tone == Tone.warning ? Theme.warning-soft
        : tone == Tone.danger ? Theme.danger-soft
        : tone == Tone.info ? Theme.action-soft
        : Theme.neutral-soft;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 3px;
        padding-bottom: 3px;
        Text {
            text: root.text;
            font-size: Theme.font-small;
            font-weight: 600;
            color: tone == Tone.success ? Theme.success
                : tone == Tone.warning ? Theme.warning
                : tone == Tone.danger ? Theme.danger
                : tone == Tone.info ? Theme.action
                : Theme.text-muted;
            vertical-alignment: center;
        }
    }
}

// Windows 11 기본 글꼴 Segoe Fluent Icons의 글리프. 글꼴을 동봉하지 않는다.
export global Icons {
    out property <string> home: "\u{E80F}";
    out property <string> data: "\u{E8A5}";
    out property <string> constraints: "\u{E8FD}";
    out property <string> timetable: "\u{E787}";
    out property <string> review: "\u{E9D5}";
    out property <string> export: "\u{E898}";
    out property <string> settings: "\u{E713}";
    out property <string> help: "\u{E897}";
    out property <string> undo: "\u{E7A7}";
    out property <string> redo: "\u{E7A6}";
    out property <string> lock: "\u{E72E}";
    out property <string> search: "\u{E721}";
}

// 장식용 아이콘. 의미는 옆의 텍스트나 accessible-label이 전달한다.
export component Icon inherits Text {
    font-family: "Segoe Fluent Icons";
    font-size: 16px;
    horizontal-alignment: center;
    vertical-alignment: center;
    accessible-role: AccessibleRole.none;
}

// 아이콘만 있는 버튼. label은 화면 읽기 프로그램용 이름이다.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 36px;
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.pressed ? Theme.neutral-soft : touch.has-hover ? #F5F7FA : Theme.surface;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    Icon {
        text: root.icon;
        font-size: 14px;
        color: root.enabled ? Theme.text : Theme.text-subtle;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// 흰 표면 + 테두리 카드
export component Panel inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
}
