export enum Tone { neutral, info, success, warning, danger }

// 밝은 업무 화면의 색상과 기본 밀도.
export global Theme {
    out property <color> bg: #F7F8FA;
    out property <color> surface: #FFFFFF;
    out property <color> text: #182230;
    out property <color> text-muted: #475569;
    out property <color> text-subtle: #5F6F85;
    out property <color> border: #E3E7EE;
    out property <color> action: #2456A6;
    out property <color> action-hover: #1B4280;
    out property <color> action-soft: #E7EEF9;
    out property <color> neutral-soft: #EEF1F5;
    out property <color> success: #1E7A46;
    out property <color> success-soft: #E5F4EA;
    out property <color> warning: #9A5B00;
    out property <color> warning-soft: #FDF1DC;
    out property <color> danger: #B42318;
    out property <color> danger-soft: #FDE8E6;
    // 키보드 포커스 표시. 배경과 3:1 이상 대비가 나야 한다 (WCAG 2.2 2.4.13 참고).
    out property <color> focus: #182230;

    out property <length> radius: 6px;
    out property <length> space-small: 4px;
    out property <length> space-medium: 8px;
    out property <length> space-large: 16px;
    out property <length> page-padding: 20px;
    out property <length> control-height: 32px;
    out property <length> min-target: 24px;
    out property <length> navigation-height: 40px;
    out property <length> font-body: 13px;
    out property <length> font-small: 12px;
    out property <length> font-title: 20px;
    out property <string> font-family: "Segoe UI";

    public pure function tone-background(tone: Tone) -> color {
        return tone == Tone.success ? root.success-soft
            : tone == Tone.warning ? root.warning-soft
            : tone == Tone.danger ? root.danger-soft
            : tone == Tone.info ? root.action-soft
            : root.neutral-soft;
    }

    public pure function tone-foreground(tone: Tone) -> color {
        return tone == Tone.success ? root.success
            : tone == Tone.warning ? root.warning
            : tone == Tone.danger ? root.danger
            : tone == Tone.info ? root.action
            : root.text-muted;
    }
}

// Windows 11 기본 글꼴 Segoe Fluent Icons의 글리프. 글꼴을 동봉하지 않는다.
export global Icons {
    out property <string> home: "\u{E80F}";
    out property <string> data: "\u{E8A5}";
    out property <string> constraints: "\u{E8FD}";
    out property <string> timetable: "\u{E787}";
    out property <string> review: "\u{E9D5}";
    out property <string> export: "\u{E898}";
    out property <string> settings: "\u{E713}";
    out property <string> help: "\u{E897}";
    out property <string> undo: "\u{E7A7}";
    out property <string> redo: "\u{E7A6}";
    out property <string> lock: "\u{E72E}";
    out property <string> search: "\u{E721}";
    out property <string> close: "\u{E711}";
    out property <string> info: "\u{E946}";
    out property <string> success: "\u{E930}";
    out property <string> warning: "\u{E7BA}";
    out property <string> error: "\u{EA39}";
    out property <string> external: "\u{E8A7}";
    out property <string> add: "\u{E710}";
    out property <string> folder: "\u{E8B7}";
    out property <string> restore: "\u{E777}";

    public pure function for-tone(tone: Tone) -> string {
        return tone == Tone.success ? root.success
            : tone == Tone.warning ? root.warning
            : tone == Tone.danger ? root.error
            : tone == Tone.info ? root.info : "";
    }
}

// 장식용 아이콘. 화면 읽기 프로그램에는 노출하지 않고, 의미는 옆의 텍스트나 accessible-label이 전달한다.
export component Icon inherits Text {
    font-family: "Segoe Fluent Icons";
    font-size: 16px;
    horizontal-alignment: center;
    vertical-alignment: center;
    accessible-role: AccessibleRole.none;
}

// 상태 점. Rectangle이라 화면 읽기 프로그램이 읽지 않는다.
export component Dot inherits Rectangle {
    width: 8px;
    height: 8px;
    border-radius: 4px;
}

// 키보드 포커스 표시. 쓰는 쪽에서 요소보다 3px 크게 배치한다.
export component FocusRing inherits Rectangle {
    border-width: 2px;
    border-color: Theme.focus;
    border-radius: Theme.radius + 2px;
}

// 상태·강도·출처 배지. 색만으로 의미를 전달하지 않도록 항상 텍스트를 함께 쓴다.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <Tone> tone: Tone.neutral;
    in property <string> icon: tone == Tone.info ? "" : Icons.for-tone(tone);
    private property <color> ink: Theme.tone-foreground(tone);

    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 4px;
    background: Theme.tone-background(tone);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: Theme.space-medium;
        padding-right: Theme.space-medium;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: Theme.space-small;
        if root.icon != "": Icon {
            width: 12px;
            font-size: 11px;
            text: root.icon;
            color: root.ink;
        }
        Text {
            text: root.text;
            font-size: Theme.font-small;
            font-weight: 600;
            color: root.ink;
            vertical-alignment: center;
            accessible-role: AccessibleRole.none;
        }
    }
}

// 흰 표면 + 테두리 카드
export component Panel inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
}

// 아이콘만 있는 버튼. label은 화면 읽기 프로그램용 이름이다.
// Tab으로 포커스를 받고 Enter·Space로 누른다. enabled가 false면 포커스와 동작 모두 막는다.
export component IconButton inherits FocusScope {
    in property <string> icon;
    in property <string> label;
    callback clicked;
    property <bool> keyboard-focus;

    width: 36px;
    height: Theme.control-height;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    key-pressed(event) => {
        if (root.enabled && (event.text == Key.Return || event.text == Key.Space)) {
            root.clicked();
            return accept;
        }
        return reject;
    }
    focus-gained(reason) => {
        root.keyboard-focus = reason == FocusReason.tab-navigation;
    }
    focus-lost(reason) => {
        root.keyboard-focus = false;
    }

    Rectangle {
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;
        background: !root.enabled ? Theme.bg : touch.pressed ? Theme.neutral-soft : touch.has-hover ? #F5F7FA : Theme.surface;
        Icon {
            text: root.icon;
            font-size: 14px;
            color: root.enabled ? Theme.text : Theme.text-subtle;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    if root.keyboard-focus: FocusRing {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
    }
}

// 잠금 스위치. 상태를 직접 바꾸지 않고 toggled만 알린다(제어 컴포넌트).
// 표시 값은 항상 모델(checked)에서 오므로 다른 카드를 선택해도 바인딩이 깨지지 않는다.
export component LockSwitch inherits FocusScope {
    in property <bool> checked;
    in property <string> label;
    callback toggled;
    property <bool> keyboard-focus;

    width: 40px;
    height: Theme.min-target;
    accessible-role: AccessibleRole.switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.toggled();
        }
    }
    key-pressed(event) => {
        if (root.enabled && (event.text == Key.Space || event.text == Key.Return)) {
            root.toggled();
            return accept;
        }
        return reject;
    }
    focus-gained(reason) => {
        root.keyboard-focus = reason == FocusReason.tab-navigation;
    }
    focus-lost(reason) => {
        root.keyboard-focus = false;
    }

    Rectangle {
        height: 22px;
        y: (root.height - self.height) / 2;
        border-radius: self.height / 2;
        background: root.checked ? Theme.action : Theme.surface;
        border-width: root.checked ? 0px : 1px;
        border-color: Theme.text-muted;
        Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            x: root.checked ? parent.width - self.width - 4px : 4px;
            y: (parent.height - self.height) / 2;
            background: root.checked ? Theme.surface : Theme.text-muted;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.focus();
            root.toggled();
        }
    }
    if root.keyboard-focus: FocusRing {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: (root.height + 6px) / 2;
    }
}
