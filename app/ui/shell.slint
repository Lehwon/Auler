import { ComboBox, LineEdit } from "std-widgets.slint";
import { Theme, Badge, Tone, Icon, Dot, FocusRing } from "theme.slint";
import { Labels } from "labels.slint";

// 상단바: 학과/학기, 버전, 저장 상태, 검색, 언어 (명세서 3.2, 그림 2)
// 학과명은 원본 자료, 학기 표기는 앱이 만드는 문구다.
export component TopBar inherits Rectangle {
    in property <string> department;
    in property <string> term-label;
    in property <string> version;
    in property <int> language-index;
    callback language-selected(int);

    height: 52px;
    background: Theme.surface;
    accessible-role: AccessibleRole.banner;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            horizontal-stretch: 0;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 5px;
                    background: Theme.action;
                    Text {
                        text: "A";
                        color: white;
                        font-size: 15px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: AccessibleRole.none;
                    }
                }
            }
            Text {
                text: "Auler";
                font-size: 18px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
        }

        Rectangle { width: 16px; }

        Text {
            text: root.department + "  /  " + root.term-label;
            color: Theme.text;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            min-width: 120px;
        }
        VerticalLayout {
            alignment: center;
            Badge { text: root.version; tone: Tone.info; }
        }

        Rectangle { horizontal-stretch: 1; }

        HorizontalLayout {
            spacing: 6px;
            horizontal-stretch: 0;
            VerticalLayout {
                alignment: center;
                Dot { background: Theme.success; }
            }
            Text {
                text: @tr("Saved");
                color: Theme.success;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            alignment: center;
            LineEdit {
                min-width: 120px;
                preferred-width: 200px;
                horizontal-stretch: 0;
                placeholder-text: @tr("Search");
                accessible-label: @tr("Search");
            }
        }
        VerticalLayout {
            alignment: center;
            // 언어 이름은 각 언어로 표기한다 (번역하지 않음)
            ComboBox {
                width: 110px;
                model: ["한국어", "English"];
                current-index: root.language-index;
                accessible-label: @tr("Language");
                selected(value) => {
                    root.language-selected(self.current-index);
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

// 왼쪽 내비게이션 항목. compact이면 아이콘 레일로 접히고, 이름은 화면 읽기 프로그램에만 남는다.
// Tab으로 포커스, Enter·Space로 이동한다. 현재 화면은 선택된 탭으로 알린다.
export component NavItem inherits FocusScope {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    in property <bool> compact;
    in property <int> count: 0;
    callback clicked;
    property <bool> keyboard-focus;

    height: 40px;
    accessible-role: AccessibleRole.tab;
    accessible-label: root.label;
    accessible-description: root.count > 0 ? Labels.pending(root.count) : "";
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-action-default => {
        root.clicked();
    }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == Key.Space) {
            root.clicked();
            return accept;
        }
        return reject;
    }
    focus-gained(reason) => {
        root.keyboard-focus = reason == FocusReason.tab-navigation;
    }
    focus-lost(reason) => {
        root.keyboard-focus = false;
    }

    Rectangle {
        border-radius: Theme.radius;
        background: root.active ? Theme.action-soft : touch.has-hover ? Theme.neutral-soft : transparent;

        HorizontalLayout {
            padding-left: root.compact ? 0px : 12px;
            padding-right: root.compact ? 0px : 12px;
            spacing: 12px;
            alignment: root.compact ? center : start;
            Icon {
                text: root.icon;
                color: root.active ? Theme.action : Theme.text-muted;
                width: 20px;
            }
            if !root.compact: Text {
                text: root.label;
                color: root.active ? Theme.action : Theme.text;
                font-weight: root.active ? 700 : 400;
                vertical-alignment: center;
                horizontal-stretch: 1;
                accessible-role: AccessibleRole.none;
            }
            if !root.compact && root.count > 0: VerticalLayout {
                alignment: center;
                Badge { text: root.count; tone: Tone.info; accessible-role: AccessibleRole.none; }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    if root.keyboard-focus: FocusRing {
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
    }
}

// 하단 상태바 (명세서 3.2)
export component StatusBar inherits Rectangle {
    in property <string> left-text;
    in property <string> right-text;

    height: 28px;
    background: #EEF1F5;
    accessible-role: AccessibleRole.content-info;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Dot { background: Theme.success; }
        }
        Text {
            text: root.left-text;
            color: Theme.text-muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.right-text;
            color: Theme.text-muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
